{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Inbox",
  "version": "../package.json",
  "identifier": "com.devinbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Inbox",
        "width": 1320,
        "height": 860,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/meetings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.2",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dev-inbox-recorder"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Your engineering inbox"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MDY0MEJCMTM0MTEwMDgKUldRSUVFRVR1MEFHaE9JN3RoOEpPUWhLbnVTTkxCRTZ5dUlLdjhBTmRURG9SSGV2V3UvQUk4N2sK",
      "endpoints": [
        "https://github.com/hrowan1/gitapp/releases/latest/download/latest.json"
      ]
    }
  }
}
